DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder dasar penyimpanan aset (subfolder otomatis: registrations, checkins, models)
CLOUDINARY_BASE_FOLDER=pcvk-kelompok5

# ---------- Parameter verifikasi wajah ----------
# Probabilitas minimum SVM agar status VERIFIED (0.0 - 1.0)
SVM_PROBABILITY_THRESHOLD=0.45
# Jarak Euclidean maksimum agar status VERIFIED
MAX_EUCLIDEAN_DISTANCE=0.65
